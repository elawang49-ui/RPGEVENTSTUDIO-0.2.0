    "comment": "4px 基准。space.N = N*4px",
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "9": 36,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "none": 0,
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "xxl": 22,
    "pill": 999
  },
  "elevation": {
    "comment": "阴影 = 偏移(x,y) + 尺寸 + 透明度（StyleBoxFlat shadow 模型）",
    "0": {
      "offset": [
        0,
        0
      ],
      "size": 0,
      "alpha": 0.0
    },
    "1": {
      "offset": [
        0,
        2
      ],
      "size": 6,
      "alpha": 0.16
    },
    "2": {
      "offset": [
        0,
        4
      ],
      "size": 12,
      "alpha": 0.24
    },
    "3": {
      "offset": [
        0,
        7
      ],
      "size": 20,
      "alpha": 0.45
    }
  },
  "motion": {
    "fast": {
      "ms": 120,
      "ease": "cubic-out"
    },
    "base": {
      "ms": 180,
      "ease": "cubic-out"
    },
    "slow": {
      "ms": 280,
      "ease": "cubic-out"
    },
    "exit": {
      "ms": 100,
      "ease": "quad-in"
    },
    "comment": "Godot Tween: TRANS_CUBIC+EASE_OUT / TRANS_QUAD+EASE_IN"
  },
  "type": {
    "comment": "字号 px；weight 映射 Godot FontVariation",
    "scale": {
      "caption": 13,
      "body": 16,
      "label": 18,
      "title": 22,
      "display": 28
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }

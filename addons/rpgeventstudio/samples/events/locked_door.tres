value = false

[sub_resource type="Resource" id="Resource_ldb2c"]
script = ExtResource("1_paqgi")
conditions = Array[ExtResource("3_cctyv")]([SubResource("Resource_rtmhg")])
commands = Array[ExtResource("2_ny5fs")]([SubResource("Resource_eret2"), SubResource("Resource_lupky")])

[resource]
script = ExtResource("4_5eqrf")
